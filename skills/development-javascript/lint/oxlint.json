{
  "plugins": ["typescript", "unicorn", "oxc", "node"],
  "jsPlugins": ["./plugin.mjs"],
  "rules": {
    "js-skill/no-class": "error",
    "js-skill/no-alias-import": "error",
    "js-skill/no-index-omit": "error",
    "js-skill/no-explicit-return-type": "error",
    "js-skill/no-filter-type-predicate": "warn",
    "js-skill/no-single-use-variable": "warn",
    "unicorn/no-array-for-each": "error",
    "func-style": ["error", "declaration"],
    "arrow-body-style": ["error", "always"],
    "node/no-process-env": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "vitest",
            "importNames": ["describe"],
            "message": "describeを使わずtestをファイルのルートレベルに書く。グルーピングはテストファイルの分離で行う"
          },
          {
            "name": "commander",
            "message": "引数解析はnode:utilのparseArgsを使う"
          },
          {
            "name": "yargs",
            "message": "引数解析はnode:utilのparseArgsを使う"
          },
          {
            "name": "meow",
            "message": "引数解析はnode:utilのparseArgsを使う"
          },
          {
            "name": "cac",
            "message": "引数解析はnode:utilのparseArgsを使う"
          },
          {
            "name": "minimist",
            "message": "引数解析はnode:utilのparseArgsを使う"
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "describe",
        "message": "describeを使わずtestをファイルのルートレベルに書く。グルーピングはテストファイルの分離で行う"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/config.ts", "**/config.js", "**/config.mts", "**/config.mjs"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/setup.*",
        "**/*.setup.*",
        "**/*-setup.*",
        "**/setup-*.*",
        "**/globalSetup.*",
        "**/global-setup.*"
      ],
      "rules": {
        "js-skill/no-module-mock": "error"
      }
    }
  ]
}
