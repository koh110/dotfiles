#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TARGET_HOME=${DOTFILES_HOME:-$HOME}
HOST_NAME=${DOTFILES_HOST:-$(hostname -s 2>/dev/null || hostname)}

is_wsl() {
  [ -n "${WSL_DISTRO_NAME:-}" ] || \
    { [ -r /proc/sys/kernel/osrelease ] && grep -qi microsoft /proc/sys/kernel/osrelease; }
}

case "$(uname -s)" in
  Linux)
    OS_LAYER=linux
    if is_wsl; then
      EXTRA_LAYER=wsl
    else
      EXTRA_LAYER=
    fi
    ;;
  Darwin)
    OS_LAYER=darwin
    EXTRA_LAYER=
    ;;
  *)
    echo "unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac

link_layer() {
  layer=$1
  [ -d "$layer" ] || return 0

  find "$layer" \( -type f -o -type l \) -print | while IFS= read -r src; do
    rel=${src#"$layer"/}
    dst="$TARGET_HOME/$rel"
    parent=$(dirname -- "$dst")

    mkdir -p "$parent"

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      echo "refusing to replace unmanaged file: $dst" >&2
      exit 1
    fi

    rm -f "$dst"
    ln -s "$src" "$dst"
    printf '%-7s %s -> %s\n' "linked" "$dst" "$src"
  done
}

echo "OS layer : $OS_LAYER"
[ -n "$EXTRA_LAYER" ] && echo "Extra    : $EXTRA_LAYER"
echo "Host     : $HOST_NAME"
echo "Home     : $TARGET_HOME"

link_layer "$ROOT/files/common"
link_layer "$ROOT/files/$OS_LAYER"
[ -n "$EXTRA_LAYER" ] && link_layer "$ROOT/files/$EXTRA_LAYER"
link_layer "$ROOT/hosts/$HOST_NAME"
